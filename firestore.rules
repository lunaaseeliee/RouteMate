rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isFullyVerified() {
  return isAuthenticated() &&
    request.auth.token.email_verified == true;
}

    function isSystemAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@routemate.com' ||
        request.auth.token.email == 'rishidubeyji68@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isFullyVerified() || isSystemAdmin();
      
      allow create: if isOwner(userId) && (
        request.resource.data.role != 'admin' ||
        request.auth.token.email == 'admin@routemate.com' ||
        request.auth.token.email == 'rishidubeyji68@gmail.com'
      );
      
      allow update: if isSystemAdmin() || (
        isOwner(userId) &&
        // Prevent normal users from escalating role to admin
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || request.resource.data.role == resource.data.role || request.resource.data.role != 'admin') &&
        // Prevent normal users from bypassing suspension
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountStatus']) || request.resource.data.accountStatus == resource.data.accountStatus) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status == resource.data.status) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSuspended']) || request.resource.data.isSuspended == resource.data.isSuspended)
      );
      
      allow delete: if isSystemAdmin();
    }

    // Rides collection
    match /rides/{rideId} {
      allow read: if isFullyVerified();
      allow create: if isFullyVerified() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.creatorId == request.auth.uid
      );
      allow update: if isFullyVerified() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isSystemAdmin() ||
        (
          (request.auth.uid in resource.data.passengerIds || request.auth.uid in request.resource.data.passengerIds) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passengers', 'passengerIds', 'availableSeats', 'updatedAt'])
        )
      );
      allow delete: if isFullyVerified() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isSystemAdmin()
      );
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSystemAdmin()
      );
      allow create: if isFullyVerified();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSystemAdmin()
      );
    }

    // Safety Reports collection - only reporter and admins can read, only admin can resolve/update
    match /reports/{reportId} {
      allow create: if isFullyVerified() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid ||
        isSystemAdmin()
      );
      allow update, delete: if isSystemAdmin();
    }

    // System Settings / Telemetry - only admin can modify
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin();
    }
  }
}

